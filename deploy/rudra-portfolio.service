# systemd *user* service, the alternative to pm2.
# Install (no sudo needed):
#   mkdir -p ~/.config/systemd/user
#   cp deploy/rudra-portfolio.service ~/.config/systemd/user/
#   # edit WorkingDirectory + ExecStart below if your folder or node path differ
#   systemctl --user daemon-reload
#   systemctl --user enable --now rudra-portfolio
#   sudo loginctl enable-linger $USER    # keep it running when you're logged out
# Logs: journalctl --user -u rudra-portfolio -f

[Unit]
Description=RUDRA.ROM portfolio (Express + React)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/Desktop/rudra-portfolio
# If Node came from nvm, replace /usr/bin/env node with the output of `which node`.
ExecStart=/usr/bin/env node server/src/server.js
Environment=NODE_ENV=production
Environment=PORT=5000
# Change to 127.0.0.1 if a proxy or tunnel on this machine fronts the site.
Environment=HOST=0.0.0.0
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
