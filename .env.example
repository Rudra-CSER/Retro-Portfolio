# ── RUDRA.ROM server config ─────────────────────────────────────────────
# Copy to .env (cp .env.example .env) and edit.

# Port + interface the Express server listens on.
# 0.0.0.0 makes it reachable from your tailnet (phone, other laptops).
PORT=5000
HOST=0.0.0.0

# MongoDB. Leave empty to run in "file mode" (JSON files in server/storage/).
# Local Docker:   mongodb://127.0.0.1:27017/rudra_portfolio   (see docker-compose.yml)
# MongoDB Atlas:  mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/rudra_portfolio
MONGODB_URI=mongodb://127.0.0.1:27017/rudra_portfolio

# Public URL of the site, used for canonical/OG tags. No trailing slash.
# Until the domain is decided, your Tailscale MagicDNS name works:
SITE_URL=http://rudra-cser-legion-5-pro-16ach6h.tailb05102.ts.net:5000

# Shown on the boot screen's HOST line (the CPU line is read live from the machine).
HOST_LABEL=LEGION 5 PRO · UBUNTU

# Bearer token for GET /api/admin/messages. Make it long and random:
#   openssl rand -hex 24
ADMIN_TOKEN=

# Express "trust proxy". loopback is right for `tailscale serve` / nginx on the same box.
TRUST_PROXY=loopback
